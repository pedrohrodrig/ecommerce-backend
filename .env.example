# Copie para .env (cp .env.example .env); o make run e os make migrate-* leem esse arquivo.
# Não use aspas nem # nos valores.

# Ambiente de execução: development ou production. Padrão: development.
APP_ENV=development

# Porta HTTP da API. Padrão: 8080.
HTTP_PORT=8080

# Obrigatória. Conexão com o PostgreSQL no formato URL; codifique caracteres
# especiais do usuário e da senha (ex.: @ como %40). Fora de localhost, use sslmode=verify-full.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce?sslmode=disable
