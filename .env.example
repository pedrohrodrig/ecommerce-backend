# Copy to .env (cp .env.example .env); make run and make migrate-* read this file.
# Do not use quotes or # in values.

# Runtime environment: development or production. Default: development.
APP_ENV=development

# API HTTP port. Default: 8080.
HTTP_PORT=8080

# Minimum log level: debug, info, warn or error. Default: info.
LOG_LEVEL=info

# Log requests to the /healthz and /readyz probes: true or false. Default: true.
# Set to false in Kubernetes, where probes run every few seconds.
LOG_PROBES=true

# Browser origins allowed to call the API (CORS), comma-separated, as
# scheme://host[:port] with no trailing slash. Wildcards are not accepted.
# Default: empty, which blocks every cross-origin browser request.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Required. PostgreSQL connection as a URL; percent-encode special characters in
# the user and password (e.g. @ as %40). Outside localhost, use sslmode=verify-full.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce?sslmode=disable
